{
  "name": "cxcix",
  "version": "1.0.0",
  "description": "Start Metro with: npm run start (Expo Go). Do not use npx run start — that is a different tool.",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-expo-apple-events.js",
    "prestart": "node scripts/check-node-modules.cjs",
    "start": "node scripts/expo-start.cjs",
    "start:dev": "node scripts/check-node-modules.cjs && node scripts/expo-start.cjs -d",
    "start:expo": "node scripts/check-node-modules.cjs && expo start --go",
    "start:clear": "node scripts/check-node-modules.cjs && node scripts/expo-start.cjs -c",
    "start:lan": "node scripts/check-node-modules.cjs && expo start --go --lan",
    "start:tunnel": "node scripts/check-node-modules.cjs && expo start --go --tunnel",
    "simulator": "open -a Simulator",
    "adb": "node scripts/run-adb.cjs",
    "adb:devices": "node scripts/run-adb.cjs devices",
    "adb:reverse": "node scripts/run-adb.cjs reverse tcp:8081 tcp:8081",
    "prebuild": "expo prebuild",
    "prebuild:all": "expo prebuild",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:android:clean": "expo prebuild --platform android --clean",
    "clean:android-native": "node scripts/clean-native-android.cjs",
    "android:gradle-clean": "node scripts/android-gradle-clean.cjs",
    "android:uninstall": "node scripts/run-adb.cjs uninstall com.cxcix.app",
    "ios:pods": "cd ios && pod install",
    "ios:open": "open \"ios/CxCix.xcworkspace\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev:ios": "expo run:ios -d",
    "dev:android": "expo run:android -d",
    "web": "expo start --web",
    "build:android:apk": "npx eas-cli build --platform android --profile preview",
    "build:android:aab": "npx eas-cli build --platform android --profile production",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@daily-co/react-native-daily-js": "^0.84.1",
    "@daily-co/react-native-webrtc": "^124.0.6-daily.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "axios": "^1.14.0",
    "babel-preset-expo": "~54.0.10",
    "emoji-mart-native": "^0.6.5-beta",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.12.1",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
