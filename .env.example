# Copy to .env — never commit real secrets.

# --- API (device must reach this host; avoid localhost on a physical phone) ---
# Deployed (Render): REST is `/api`, Socket.IO is host root (no `/api`).
# EXPO_PUBLIC_API_URL=https://cxcix-backend.onrender.com/api
# EXPO_PUBLIC_SOCKET_URL=https://cxcix-backend.onrender.com
#
# LAN IP (same Wi‑Fi as the phone):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:5001/api
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.42:5001
#
# Localhost (not recommended on physical devices):
# EXPO_PUBLIC_API_URL=http://127.0.0.1:5001/api
# EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:5001
#
# Other production / staging:
# EXPO_PUBLIC_API_URL=https://api.example.com/api
# EXPO_PUBLIC_SOCKET_URL=https://api.example.com

# Default to production (same as EAS `preview` / `production` profiles in eas.json):
EXPO_PUBLIC_API_URL=https://cxcix-backend.onrender.com/api
EXPO_PUBLIC_SOCKET_URL=https://cxcix-backend.onrender.com
EXPO_PUBLIC_DEV_API_HOST=
#
# Local backend instead (use your LAN IP on devices):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5001/api
# EXPO_PUBLIC_SOCKET_URL=http://192.168.x.x:5001

# Firebase (public keys only — from Firebase console)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Cleartext HTTP to your dev API is allowed via app.config.js `android.usesCleartextTraffic` for debug builds.
